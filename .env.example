# انسخ هذا الملف إلى .env للتجربة المحلية، وعرّف نفس القيم في Netlify:
# Site configuration → Environment variables

# رابط قاعدة PostgreSQL (Neon أو Supabase أو غيرها). خلّه سري، لا ترفعه في GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dabrah?sslmode=require

# مسار الـ API اللي تقرأه الواجهة. خلّه /api لما تكون قاعدة البيانات جاهزة.
# اتركه فاضي = وضع العرض على البيانات التجريبية.
DABRAH_API_BASE=/api
